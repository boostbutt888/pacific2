{
  "name": "@pacific2/api",
  "version": "0.7.0",
  "private": true,
  "description": "NestJS API (REST /v1). Hosts three entry points in later sprints: api (REST), realtime (WebSocket gateway, ADR-003), worker (outbox relay + jobs).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@pacific2/contracts": "workspace:*",
    "@pacific2/money": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8"
  }
}
