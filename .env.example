# Copy to .env for local development. .env is git-ignored. Never commit real values.
# Deployed environments read secrets from AWS Secrets Manager (SECURITY.md §4).
POSTGRES_USER=pacific2
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://localhost:6379
PORT=3000
APP_VERSION=0.7.0-dev
# PSP and terminal: local and CI use the MOCK provider and the terminal SIMULATOR (ADR-004, ADR-005).
PAYMENT_PROVIDER=MOCK
TERMINAL_ADAPTER=SIMULATOR
